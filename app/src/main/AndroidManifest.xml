<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- API>=30 备份直写 内部存储/&lt;用户设定的备份文件夹&gt;（默认 backups/account）；部分 OEM 的 SAF 目录选择器被锁死 -->
    <!-- 该权限同时用于读取备份文件夹内的 appsettings.json 外挂配置 -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <!-- 可选扩展模块的签名级门禁（由本体声明同名权限 + 同 keystore 签名安装后自动授予）：
         扩展的数据桥与入口拉起均要求调用方/被调方持有此权限；权限定义在本体，扩展使用。 -->
    <permission
        android:name="com.copy.account.extension.permission.BRIDGE"
        android:protectionLevel="signature" />
    <uses-permission android:name="com.copy.account.extension.permission.BRIDGE" />

    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <!-- 应用选择器：仅声明要查询的 Launcher 应用（可见性过滤），不申请 QUERY_ALL_PACKAGES。 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- 可选扩展模块：按 action 在装发现（扩展声明同名 intent-filter），
             包可见性走 intent 匹配，无需也不包含任何具体扩展包名。 -->
        <intent>
            <action android:name="com.copy.account.action.SYNC_SETTINGS" />
            <category android:name="android.intent.category.DEFAULT" />
        </intent>
        <!-- 导出后自动上传跳板：同款 action 发现（Android 11+ 包可见性必须显式声明，
             缺失时 queryIntentActivities 恒空 → 自动上传整体静默 no-op，真机实测实锤）。 -->
        <intent>
            <action android:name="com.copy.account.action.SYNC_KICK" />
            <category android:name="android.intent.category.DEFAULT" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Account">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:label="@string/app_name"
            android:theme="@style/Theme.Account"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- 自动填充：系统 绑定服务（BIND_AUTOFILL_SERVICE 由系统持有，外部应用不可拉起）。 -->
        <service
            android:name=".service.AppAutofillService"
            android:exported="true"
            android:label="@string/autofill_service_label"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE">
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
            <meta-data
                android:name="android.service.autofill"
                android:resource="@xml/autofill_service_config" />
        </service>
        <!-- 自动填充解锁确认页：透明浮层，验证主密码/指纹后 finish 回填充流程。
             exported=false：本应用经 PendingIntent 以自身身份拉起（不算外部拉起），无 intent-filter，
             关闭后恶意应用无法直接 startActivity 伪造 extras 戳浮层（HMAC 闸门之外白赚的纵深）。 -->
        <activity
            android:name=".service.AutofillAuthActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@style/Theme.Account.Transparent" />

        <!-- 通行密钥提供方（Android 14+）：系统凭据管理器绑定服务；API<34 设备不认此声明。
             enabled 显式声明（对齐 KeePassDX；个别 ROM 对默认值处理异常）。
             xml 里 capability 名必须为 androidx.credentials.TYPE_PUBLIC_KEY_CREDENTIAL
             （androidx 请求 type 原样透传 framework 精确匹配；KeePassDX/OPPO 密码本同款）。 -->
        <service
            android:name=".service.PasskeyProviderService"
            android:enabled="true"
            android:exported="true"
            android:label="@string/passkey_service_label"
            android:permission="android.permission.BIND_CREDENTIAL_PROVIDER_SERVICE">
            <intent-filter>
                <action android:name="android.service.credentials.CredentialProviderService" />
            </intent-filter>
            <meta-data
                android:name="android.credentials.provider"
                android:resource="@xml/passkey_provider_config" />
        </service>
        <!-- 通行密钥注册/登录确认页：透明浮层（照 AutofillAuthActivity），由系统凭据流程拉起。
             exported=false：ProviderService 经 PendingIntent 以本应用身份交付给系统，同上纵深收紧。 -->
        <activity
            android:name=".service.PasskeyCreateActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@style/Theme.Account.Transparent" />
        <activity
            android:name=".service.PasskeyGetActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@style/Theme.Account.Transparent" />

        <!-- 本体 ⇆ 扩展模块文件数据桥（可选扩展机制的数据面）：授权目录内备份数据经此供给
             同签名扩展。门禁 = BRIDGE 签名权限（同 keystore 才进得来）+ 调用方包名白名单。
             本体自身的数据访问仍走本地文件直访，不经 provider；本类零联网。 -->
        <provider
            android:name=".runtime.ExtensionBridgeProvider"
            android:authorities="com.copy.account.extbridge"
            android:exported="true"
            android:grantUriPermissions="false"
            android:permission="com.copy.account.extension.permission.BRIDGE" />
    </application>

</manifest>
